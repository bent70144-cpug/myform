{
  "name": "@form/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:vercel": "pnpm -w build && pnpm exec esbuild serverless/adapter.ts --bundle --platform=node --format=cjs --target=node20 --outfile=api/main.js --external:@nestjs/microservices --external:@nestjs/microservices/microservices-module.js --external:@nestjs/websockets --external:@nestjs/websockets/socket-module.js --log-limit=0"
  },
  "dependencies": {
    "@form/auth": "workspace:*",
    "@form/contracts": "workspace:*",
    "@form/database": "workspace:*",
    "@form/form-schema": "workspace:*",
    "@form/i18n": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.4",
    "express": "5.3.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@form/config": "workspace:*",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "esbuild": "^0.28.2",
    "kysely": "^0.28.8",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
