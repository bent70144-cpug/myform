{
  "name": "myform",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:up": "node scripts/dev-env.mjs start",
    "local:down": "node scripts/dev-env.mjs stop",
    "local:status": "node scripts/dev-env.mjs status",
    "db:bootstrap": "pnpm --filter @myform/db run bootstrap",
    "db:migrate": "pnpm --filter @myform/db run migrate"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
