# myform — environment configuration
# Copy to .env for local development. Local dev uses the documented Docker
# substitute: embedded-postgres (scripts/dev-env.mjs) + Mailpit binary.
# In deployments only the variables a process needs are handed to it; the
# supervisor allowlist (scripts/supervisor.mjs) enforces that for Next.js.

# --- Core ---------------------------------------------------------------
MYFORM_ENV=development            # development | test | production
LOG_LEVEL=info                    # debug | info | warn | error

# --- Ports and origins --------------------------------------------------
API_PORT=4000                     # NestJS internal port
WEB_PORT=3000                     # Next.js public port
INTERNAL_API_URL=http://127.0.0.1:4000   # used by web (server-side) and supervisor
APP_ORIGIN=http://localhost:3000  # public origin; Origin-check allowlist

# --- Database URLs (role-separated) -------------------------------------
# app_user — request path (pooled URL in deployment)
DATABASE_URL=postgres://app_user:app_user_password@127.0.0.1:54329/myform
# worker_user — worker + pg-boss (direct URL in deployment)
WORKER_DATABASE_URL=postgres://worker_user:worker_user_password@127.0.0.1:54329/myform
# migrator — migrations only (never present in web/API/worker runtime env)
MIGRATOR_DATABASE_URL=postgres://migrator:migrator_password@127.0.0.1:54329/myform
# admin superuser — one-time bootstrap only (embedded-postgres local superuser)
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/myform

# --- Role passwords (read by the admin bootstrap; never in migrations) ---
MIGRATOR_PASSWORD=migrator_password
APP_USER_PASSWORD=app_user_password
WORKER_USER_PASSWORD=worker_user_password

# --- Worker -------------------------------------------------------------
WORKER_HEARTBEAT_MS=15000

# --- Local dev environment (scripts/dev-env.mjs) ------------------------
DEV_ENV_DIR=.local/dev-env        # state + Postgres data dir (gitignored)
DEV_ENV_PG_PORT=54329
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- Auth secrets (NOT used in ticket 01; wired by the auth-core slice) --
# AUTH_SECRET=                    # Better Auth secret — API only, never web
